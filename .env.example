# 이 파일을 .env로 복사해 로컬에서만 씁니다. 실제 키를 이 파일에 적어 커밋하지 마세요.

# 음성 PoC용 대본 면접 두뇌와 인위적 지연(?lab_delay_ms)을 켭니다. 데모·배포에서는 false.
LAB_ENABLED=false
# 쉼표로 구분한 CORS 허용 출처 (예: http://localhost:3000). 같은 도메인으로 붙으면 비워 둡니다.
CORS_ORIGINS=
# Postgres 접속 주소 (postgresql://user:password@host:5432/dbname). Railway가 주는 주소를 그대로 넣어도 됩니다.
# 비워 두면 DB 없이 돌고 /api/metrics 이벤트는 METRICS_PATH(JSONL)에 쌓입니다.
DATABASE_URL=
METRICS_PATH=.data/metrics.jsonl
# GitHub 로그인(#18). GitHub App 설정 화면의 Client ID와 Client secret입니다. 값은 비밀번호 관리자에서 받습니다.
# App의 Callback URL은 <WEB_ORIGIN>/api/auth/github/callback으로 등록합니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 로그인 쿠키 암호화 키 (32자 이상). 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 바꾸면 모든 사용자가 다시 로그인해야 합니다. 환경마다 다른 값을 씁니다.
SESSION_SECRET=
# 브라우저가 여는 웹 주소 (경로 없이). 로그인 콜백 주소와 로그인 뒤 돌아갈 주소를 만듭니다.
WEB_ORIGIN=http://localhost:3000
# 로그인 쿠키의 Secure 표시. 배포에서는 true. http://localhost에 Secure 쿠키를 저장하지 않는 브라우저로 개발할 때만 false로 바꿉니다.
COOKIE_SECURE=true

# 판단·분석·리포트 LLM 제공사 (openai | gemini). 장애 시 이 값만 바꿉니다.
LLM_PROVIDER=openai
# 비워 두면 제공사 기본 모델을 씁니다. 값을 넣으면 LLM_PROVIDER보다 우선합니다.
LLM_JUDGE_MODEL=
LLM_ANALYSIS_MODEL=
LLM_REPORT_MODEL=
# true면 LLM 없이 미리 만든 질문과 턴별 판단 표로 진행합니다 (장애 대비).
BRAIN_FORCE_PREPARED=false
LLM_JUDGE_REASONING_EFFORT=
JUDGE_TIMEOUT_S=2.5
# 인용문 비교 방식 (exact | fuzzy). fuzzy는 음성 인식 오차를 유사도로 허용합니다.
QUOTE_MATCH=exact
QUOTE_FUZZY_THRESHOLD=80

# 제공사 키는 LiteLLM 규칙의 환경 변수 이름을 씁니다. 값은 비밀번호 관리자에서 받습니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
