# 이 파일을 .env로 복사해 로컬에서만 씁니다. 실제 키를 이 파일에 적어 커밋하지 마세요.

# 음성 PoC용 대본 면접 두뇌와 인위적 지연(?lab_delay_ms)을 켭니다. 데모·배포에서는 false.
LAB_ENABLED=false
# 쉼표로 구분한 CORS 허용 출처 (예: http://localhost:3000). 같은 도메인으로 붙으면 비워 둡니다.
CORS_ORIGINS=
METRICS_PATH=.data/metrics.jsonl

# 판단·분석·리포트 LLM 제공사 (openai | gemini). 장애 시 이 값만 바꿉니다.
LLM_PROVIDER=openai
# 비워 두면 제공사 기본 모델을 씁니다. 값을 넣으면 LLM_PROVIDER보다 우선합니다.
LLM_JUDGE_MODEL=
LLM_ANALYSIS_MODEL=
LLM_REPORT_MODEL=
# true면 LLM 없이 미리 만든 질문과 턴별 판단 표로 진행합니다 (장애 대비).
BRAIN_FORCE_PREPARED=false
LLM_JUDGE_REASONING_EFFORT=
JUDGE_TIMEOUT_S=2.5

# 제공사 키는 LiteLLM 규칙의 환경 변수 이름을 씁니다. 값은 비밀번호 관리자에서 받습니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
