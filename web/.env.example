# web/.env.local로 복사해 로컬에서만 씁니다. 실제 키를 이 파일에 적어 커밋하지 마세요.

# FastAPI 서버 주소. /api/* 요청을 여기로 넘깁니다.
API_ORIGIN=http://localhost:8000

# 음성 PoC(/lab/voice)와 임시 토큰 라우트(/lab/voice-token)를 켭니다. 데모·배포에서는 false.
# 토큰 발급은 계약상 FastAPI의 POST /api/sessions/{id}/voice-token으로 옮길 예정입니다.
LAB_ENABLED=false

# 음성 AI(Gemini Live) 키. 값은 비밀번호 관리자에서 받습니다.
GEMINI_API_KEY=

# 모델과 목소리 (비우면 아래 기본값)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore
